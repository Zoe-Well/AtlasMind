ATLASMIND_AUTH_MODE=local
ATLASMIND_SESSION_SECRET=replace-with-at-least-32-random-characters
ATLASMIND_API_URL=http://localhost:8000

# Required only when ATLASMIND_AUTH_MODE=oidc
ATLASMIND_OIDC_ISSUER=
ATLASMIND_OIDC_CLIENT_ID=
ATLASMIND_OIDC_CLIENT_SECRET=
ATLASMIND_OIDC_AUTHORIZATION_ENDPOINT=
ATLASMIND_OIDC_TOKEN_ENDPOINT=
ATLASMIND_OIDC_JWKS_URI=
ATLASMIND_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
