ATLASMIND_ENVIRONMENT=development
ATLASMIND_PROCESS_ROLE=api
ATLASMIND_DATABASE_URL=postgresql+asyncpg://atlasmind:atlasmind-local-only@localhost:5432/atlasmind
ATLASMIND_OBJECT_STORE_ENDPOINT=http://localhost:9000
ATLASMIND_OBJECT_STORE_BUCKET=atlasmind
ATLASMIND_OBJECT_STORE_ACCESS_KEY=atlasmind-local
ATLASMIND_OBJECT_STORE_SECRET_KEY=atlasmind-local-secret
# Recommended split-provider configuration: DeepSeek chat + local Ollama embeddings.
ATLASMIND_CHAT_BASE_URL=https://api.deepseek.com
ATLASMIND_CHAT_API_KEY=
ATLASMIND_CHAT_MODEL=deepseek-chat
# Optional DeepSeek thinking toggle; blank preserves the provider default.
ATLASMIND_CHAT_THINKING_ENABLED=
ATLASMIND_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
ATLASMIND_EMBEDDING_API_KEY=ollama-local
ATLASMIND_EMBEDDING_MODEL=bge-m3

# Backward-compatible shared endpoint. Leave empty when using both dedicated pairs above.
ATLASMIND_MODEL_BASE_URL=
ATLASMIND_MODEL_API_KEY=
ATLASMIND_NEO4J_URI=bolt://localhost:7687
ATLASMIND_NEO4J_USERNAME=neo4j
ATLASMIND_NEO4J_PASSWORD=atlasmind-local-secret
ATLASMIND_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ATLASMIND_AUTH_MODE=local
ATLASMIND_SESSION_SECRET=replace-with-at-least-32-random-characters
ATLASMIND_API_URL=http://localhost:8000

# Optional local Yifulu HQ draft integration; generated by scripts/Start-YifuluMvp.ps1.
# Dedicated common-support scope; never grant the legacy general/local scope to the service.
ATLASMIND_SERVICE_JWT_SECRET=
ATLASMIND_SERVICE_SCOPE_ID=00000000-0000-4000-8000-000000000030
# Optional HQ ordinary knowledge: separate credentials from customer-service drafts.
ATLASMIND_HQ_SERVICE_JWT_SECRET=
ATLASMIND_HQ_SCOPE_ID=00000000-0000-4000-8000-000000000020
